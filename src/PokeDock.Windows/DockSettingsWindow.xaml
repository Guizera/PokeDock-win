<Window
    x:Class="PokeDock.Windows.DockSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PokeDock.Windows"
    Title="PokeDock">

    <Grid x:Name="Root" Loaded="Root_Loaded" Background="{StaticResource GameBoyShellBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="20" Spacing="17">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="22" Height="22" Fill="{StaticResource GameBoyActionBrush}" Stroke="White" StrokeThickness="3" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock local:Localization.Key="CustomizeDock" FontFamily="{StaticResource GameBoyFont}" FontSize="20" FontWeight="Black" CharacterSpacing="70" Foreground="{StaticResource GameBoyDarkBrush}" />
                        <TextBlock local:Localization.Key="ThemesAppsWidgets" FontFamily="{StaticResource GameBoyFont}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GameBoyMidBrush}" />
                    </StackPanel>
                </Grid>

                <Border Padding="9" Background="{StaticResource GameBoyBezelBrush}" CornerRadius="18">
                    <Border Padding="14" Background="{StaticResource GameBoyScreenBrush}" BorderBrush="{StaticResource GameBoyDarkBrush}" BorderThickness="3" CornerRadius="10">
                        <StackPanel Spacing="10">
                            <TextBlock local:Localization.Key="Preview" FontFamily="{StaticResource GameBoyFont}" FontSize="13" FontWeight="Black" Foreground="{StaticResource GameBoyDarkBrush}" />
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                <Border x:Name="PreviewSurface" Height="70" HorizontalAlignment="Center" Padding="14,7" CornerRadius="20">
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <local:PokedexDockIcon Width="46" Height="46" />
                                        <TextBlock Text="│" FontSize="28" Foreground="#66FFFFFF" VerticalAlignment="Center" />
                                        <StackPanel x:Name="PreviewWidgetsPanel" Orientation="Horizontal" Spacing="6" />
                                        <TextBlock x:Name="PreviewRightDivider" Text="│" FontSize="28" Foreground="#66FFFFFF" VerticalAlignment="Center" />
                                        <local:PixelArtImage x:Name="PreviewPokemon" Width="46" Height="46" />
                                        <TextBlock Text="⚙" FontSize="20" Foreground="White" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Border>

                <Border Padding="9" Background="{StaticResource GameBoyBezelBrush}" CornerRadius="18">
                    <Border Padding="14" Background="{StaticResource GameBoyScreenBrush}" BorderBrush="{StaticResource GameBoyDarkBrush}" BorderThickness="3" CornerRadius="10">
                        <StackPanel Spacing="10">
                            <TextBlock local:Localization.Key="EncounterSettings" FontFamily="{StaticResource GameBoyFont}" FontSize="13" FontWeight="Black" Foreground="{StaticResource GameBoyDarkBrush}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock local:Localization.Key="Frequency" VerticalAlignment="Center" FontFamily="{StaticResource GameBoyFont}" FontSize="11" FontWeight="Black" Foreground="{StaticResource GameBoyDarkBrush}" />
                                <ComboBox x:Name="FrequencyCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="FrequencyCombo_SelectionChanged" FontFamily="{StaticResource GameBoyFont}" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="FrequencyDescriptionText" Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap" FontFamily="{StaticResource GameBoyFont}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GameBoyMidBrush}" />
                            </Grid>
                            <ToggleSwitch x:Name="PauseEncountersToggle" local:Localization.Key="PauseAppearances" local:Localization.OnKey="Yes" local:Localization.OffKey="No" Toggled="PauseEncountersToggle_Toggled" FontFamily="{StaticResource GameBoyFont}" FontWeight="Bold" />
                            <TextBlock local:Localization.Key="PauseAppearancesHint" TextWrapping="Wrap" FontFamily="{StaticResource GameBoyFont}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GameBoyMidBrush}" />
                        </StackPanel>
                    </Border>
                </Border>

                <Border Padding="9" Background="{StaticResource GameBoyBezelBrush}" CornerRadius="18">
                    <Border Padding="14" Background="{StaticResource GameBoyScreenBrush}" BorderBrush="{StaticResource GameBoyDarkBrush}" BorderThickness="3" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="240" />
                            </Grid.RowDefinitions>
                            <TextBlock local:Localization.Key="Themes" FontFamily="{StaticResource GameBoyFont}" FontSize="13" FontWeight="Black" Foreground="{StaticResource GameBoyDarkBrush}" />
                            <Grid x:Name="ThemeGrid" Grid.Row="2" ColumnSpacing="9" RowSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>

                <Border Padding="9" Background="{StaticResource GameBoyBezelBrush}" CornerRadius="18">
                    <Border Padding="14" Background="{StaticResource GameBoyScreenBrush}" BorderBrush="{StaticResource GameBoyDarkBrush}" BorderThickness="3" CornerRadius="10">
                        <StackPanel Spacing="9">
                            <TextBlock local:Localization.Key="AppearanceBehavior" FontFamily="{StaticResource GameBoyFont}" FontSize="13" FontWeight="Black" Foreground="{StaticResource GameBoyDarkBrush}" />
                            <ToggleSwitch x:Name="AnimationsToggle" local:Localization.Key="AnimateTheme" local:Localization.OnKey="Yes" local:Localization.OffKey="No" Toggled="AnimationsToggle_Toggled" FontFamily="{StaticResource GameBoyFont}" FontWeight="Bold" />
                            <ToggleSwitch x:Name="RunningAppsToggle" local:Localization.Key="ShowRunningApps" local:Localization.OnKey="Yes" local:Localization.OffKey="No" Toggled="RunningAppsToggle_Toggled" FontFamily="{StaticResource GameBoyFont}" FontWeight="Bold" />
                            <ToggleSwitch x:Name="AllDisplaysToggle" local:Localization.Key="ShowOnAllDisplays" local:Localization.OnKey="Yes" local:Localization.OffKey="No" Toggled="AllDisplaysToggle_Toggled" FontFamily="{StaticResource GameBoyFont}" FontWeight="Bold" />
                            <ToggleSwitch x:Name="StartupToggle" local:Localization.Key="StartWithWindows" local:Localization.OnKey="Yes" local:Localization.OffKey="No" Toggled="StartupToggle_Toggled" FontFamily="{StaticResource GameBoyFont}" FontWeight="Bold" />
                            <TextBlock x:Name="StartupStatusText" TextWrapping="Wrap" FontFamily="{StaticResource GameBoyFont}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GameBoyMidBrush}" />
                            <ToggleSwitch x:Name="EncounterNotificationsToggle" local:Localization.Key="EncounterNotifications" local:Localization.OnKey="Yes" local:Localization.OffKey="No" Toggled="EncounterNotificationsToggle_Toggled" FontFamily="{StaticResource GameBoyFont}" FontWeight="Bold" />
                            <ToggleSwitch x:Name="NotificationBadgesToggle" local:Localization.Key="NotificationBadges" local:Localization.OnKey="Yes" local:Localization.OffKey="No" Toggled="NotificationBadgesToggle_Toggled" FontFamily="{StaticResource GameBoyFont}" FontWeight="Bold" />
                            <TextBlock x:Name="NotificationStatusText" TextWrapping="Wrap" FontFamily="{StaticResource GameBoyFont}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GameBoyMidBrush}" />
                            <TextBlock local:Localization.Key="TaskbarRestoreHint" FontFamily="{StaticResource GameBoyFont}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GameBoyMidBrush}" />
                        </StackPanel>
                    </Border>
                </Border>

                <Border Padding="9" Background="{StaticResource GameBoyBezelBrush}" CornerRadius="18">
                    <Border Padding="14" Background="{StaticResource GameBoyScreenBrush}" BorderBrush="{StaticResource GameBoyDarkBrush}" BorderThickness="3" CornerRadius="10">
                        <StackPanel Spacing="10">
                            <TextBlock local:Localization.Key="DataUpdates" FontFamily="{StaticResource GameBoyFont}" FontSize="13" FontWeight="Black" Foreground="{StaticResource GameBoyDarkBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button local:Localization.Key="ExportCollection" Click="ExportCollection_Click" Style="{StaticResource GameBoyButtonStyle}" />
                                <Button Grid.Column="1" local:Localization.Key="ImportCollection" Click="ImportCollection_Click" Style="{StaticResource GameBoyButtonStyle}" />
                                <Button Grid.Column="2" HorizontalAlignment="Right" local:Localization.Key="CheckUpdates" Click="CheckUpdates_Click" Style="{StaticResource GameBoyButtonStyle}" />
                            </Grid>
                            <TextBlock x:Name="DataStatusText" TextWrapping="Wrap" FontFamily="{StaticResource GameBoyFont}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GameBoyMidBrush}" />
                        </StackPanel>
                    </Border>
                </Border>

                <Border Padding="9" Background="{StaticResource GameBoyBezelBrush}" CornerRadius="18">
                    <Border Padding="14" Background="{StaticResource GameBoyScreenBrush}" BorderBrush="{StaticResource GameBoyDarkBrush}" BorderThickness="3" CornerRadius="10">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock local:Localization.Key="BarItems" FontFamily="{StaticResource GameBoyFont}" FontSize="13" FontWeight="Black" Foreground="{StaticResource GameBoyDarkBrush}" VerticalAlignment="Center" />
                                <Button x:Name="AddAppButton" Grid.Column="1" local:Localization.Key="AddApp" Click="AddAppButton_Click" FontFamily="{StaticResource GameBoyFont}" FontSize="10" FontWeight="Bold" />
                                <Button x:Name="AddWidgetButton" Grid.Column="3" local:Localization.Key="AddWidget" FontFamily="{StaticResource GameBoyFont}" FontSize="10" FontWeight="Bold" />
                            </Grid>
                            <StackPanel x:Name="DockItemsPanel" Spacing="8" />
                            <TextBlock local:Localization.Key="BarItemsHint" TextWrapping="Wrap" FontFamily="{StaticResource GameBoyFont}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GameBoyMidBrush}" />
                        </StackPanel>
                    </Border>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
