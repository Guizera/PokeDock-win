<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>PokeDock.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TaskbarWatchdogRuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</TaskbarWatchdogRuntimeIdentifier>
    <TaskbarWatchdogRuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</TaskbarWatchdogRuntimeIdentifier>
    <TaskbarWatchdogIntermediateDirectory>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)taskbar-watchdog\$(Configuration)\$(TaskbarWatchdogRuntimeIdentifier)\obj\</TaskbarWatchdogIntermediateDirectory>
    <TaskbarWatchdogPublishDirectory>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)taskbar-watchdog\$(Configuration)\$(TaskbarWatchdogRuntimeIdentifier)\publish\</TaskbarWatchdogPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PokeDock.Core\PokeDock.Core.csproj" />
    <ProjectReference Include="..\PokeDock.Application\PokeDock.Application.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TaskbarWatchdogRuntimeIdentifier)' != ''">
    <Content Include="$(TaskbarWatchdogPublishDirectory)PokeDock.TaskbarWatchdog.exe">
      <Link>PokeDock.TaskbarWatchdog.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\App\*.png" />
    <Content Include="Assets\Data\pokemon.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Pokemon\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PublishTaskbarWatchdog"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(TaskbarWatchdogRuntimeIdentifier)' != ''">
    <MSBuild Projects="..\PokeDock.TaskbarWatchdog\PokeDock.TaskbarWatchdog.csproj"
             Targets="Restore"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(TaskbarWatchdogRuntimeIdentifier);BaseIntermediateOutputPath=$(TaskbarWatchdogIntermediateDirectory);PublishDir=$(TaskbarWatchdogPublishDirectory)" />
    <MSBuild Projects="..\PokeDock.TaskbarWatchdog\PokeDock.TaskbarWatchdog.csproj"
             Targets="Publish"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(TaskbarWatchdogRuntimeIdentifier);BaseIntermediateOutputPath=$(TaskbarWatchdogIntermediateDirectory);PublishDir=$(TaskbarWatchdogPublishDirectory);NoRestore=true" />
  </Target>
</Project>

